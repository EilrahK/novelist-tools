{
  "name": "novelist-tools",
  "displayName": "novelist-tools",
  "description": "Tools to help novelist",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./src/extension.js",
  "contributes": {
		"commands": [
			{
				"command": "novelist-tools.session-word-counter",
				"title": "Start/stop session counter"
			},
			{
				"command": "novelist-tools.refresh-index",
				"title": "Refresh the workspace index",
        "icon": "$(refresh)"
			},
			{
				"command": "novelist-tools.refresh-characters",
				"title": "Refresh the list of characters",
        "icon": "$(refresh)"
			}
		],
		"viewsContainers": {
      "activitybar": [
        {
          "id": "novelistTools",
          "title": "Novelist tools",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "novelistTools": [
        {
          "id": "novelistToolsIndex",
          "name": "Index",
          "icon": "$(selection)",
          "contextualTitle": "Index story"
        },
        {
          "id": "novelistToolsCharacters",
          "name": "Characters",
          "icon": "$(account)",
          "contextualTitle": "Characters"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "novelist-tools.refresh-index",
          "when": "view == novelistToolsIndex",
          "group": "navigation"
        },
        {
          "command": "novelist-tools.refresh-characters",
          "when": "view == novelistToolsCharacters",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.lineNumbers": "off",
        "editor.wordWrap": "on"
      }
    }
	},
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.13.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
  }
}
